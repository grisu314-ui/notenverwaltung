# Vorlage für die .env neben der Compose-Datei (in Dockge: im
# Stack-Verzeichnis, üblicherweise /opt/stacks/notenverwaltung/.env).
#
# Die echte .env gehört NICHT ins Repository; .gitignore deckt sie ab.
# Die Anwendung selbst liest keinen dieser Werte -- sie gehören dem
# Tailscale-Sidecar und der Pforte.

# Auth-Key aus der Tailscale-Konsole, möglichst einmalig verwendbar.
TS_AUTHKEY=tskey-auth-...

# Zugang zur Pforte (Caddy, HTTP Basic Auth).
# Hash erzeugen -- fragt das Passwort ab, ohne es in die Shell-Historie zu
# schreiben:
#   docker run --rm -it caddy:2.11.4-alpine caddy hash-password
#
# Der Hash enthält `$`. Deshalb in EINFACHEN Anführungszeichen, sonst ersetzt
# Compose die Teile nach jedem `$` durch leere Variablen und niemand kommt
# mehr hinein.
PFORTE_USER=lehrer
PFORTE_HASH='$2a$14$HIER-DEN-ERZEUGTEN-HASH-EINTRAGEN'
