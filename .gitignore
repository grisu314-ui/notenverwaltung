.venv/
__pycache__/
*.py[cod]

# Local database files. The productive database never lives in the repository.
data/
# On the NAS the working tree sits one level above these two directories;
# see TRUENAS.md, step 2.
daten/
sicherungen/
*.db
*.db-wal
*.db-shm

.pytest_cache/

# Auth-Key für den Tailscale-Sidecar und Zugang der Pforte, gehört nicht ins
# Repository. Die Vorlage .env.example schon.
.env

# Caddys Zustand auf dem NAS (docker-compose.truenas.yml). Die dort abgelegte
# Konfiguration enthält den Passwort-Hash der Pforte.
pforte/

# Knotenzustand des Tailscale-Sidecars auf dem NAS, darin sein Schlüssel.
# Liegt im selben Arbeitsbaum; `git add -A` nähme ihn sonst mit.
tailscale/
